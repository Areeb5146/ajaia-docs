# Postgres connection string.
#
# Works with any Postgres: Prisma Postgres, Neon, Supabase, Railway, or a local
# instance. The app connects through Prisma's `adapter-pg` driver adapter, so
# only this value changes between environments.
#
# Fastest way to get one with no signup:
#   npx create-db
#
# Local Postgres example:
#   postgresql://postgres:postgres@localhost:5432/ajaia_docs?schema=public
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
